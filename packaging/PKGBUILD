# Maintainer: Grégory D <rginon314@github.com>
# This PKGBUILD is generated by the release workflow.
# For local builds, run: makepkg -si

pkgname=dlna-gmediarender-kde
pkgver=0.1.0
pkgrel=1
epoch=0
pkgdesc="KDE Plasma 6 applet to receive DLNA audio and switch output device live"
arch=('any')
url="https://github.com/rginon314/dlna-gmediarender-kde"
license=('MIT')
depends=('gmediarender' 'gst-plugins-good' 'gst-plugins-base'
         'gst-plugins-bad' 'gst-plugins-ugly' 'gst-libav'
         'libpulse' 'plasma-workspace')
makedepends=()
# Dependencies are resolved at install time on the user's system,
# not at build time — this is a noarch package with no compilation.
optdepends=()
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/v${pkgver}/${pkgname}-${pkgver}.tar.gz")
sha256sums=('SKIP')

package() {
    cd "${srcdir}/${pkgname}-${pkgver}"

    # CLI helper
    install -Dm755 bin/gmediarender-output \
        "${pkgdir}/usr/bin/gmediarender-output"

    # systemd user service
    install -Dm644 systemd/gmediarender.service \
        "${pkgdir}/usr/lib/systemd/user/gmediarender.service"

    # Plasma applet
    mkdir -p "${pkgdir}/usr/share/plasma/plasmoids/org.gmediarender.kde"
    cp -r plasmoid/. "${pkgdir}/usr/share/plasma/plasmoids/org.gmediarender.kde/"

    # Icon
    install -Dm644 plasmoid/contents/icons/gmediarender.svg \
        "${pkgdir}/usr/share/icons/hicolor/scalable/apps/org.gmediarender.kde.svg"

    # Default config
    install -Dm644 packaging/debian/gmediarender.conf \
        "${pkgdir}/etc/gmediarender/gmediarender.conf"

    # License
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}