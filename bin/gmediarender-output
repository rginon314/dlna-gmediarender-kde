#!/usr/bin/env bash
# bureau-receivers — manage DLNA, AirPlay and Spotify Connect receivers.
#
#   bureau-receivers --services          # TSV: name<TAB>service<TAB>state(0/1)
#   bureau-receivers --sinks            # TSV: desc<TAB>name<TAB>active(0/1)
#   bureau-receivers --current          # active sink name
#   bureau-receivers --toggle <svc>     # start/stop a service
#   bureau-receivers --restart <svc>    # restart a service
#   bureau-receivers --restart-all      # restart all services
#   bureau-receivers <sink-name>        # switch output device live
#   bureau-receivers --names            # TSV: protocol<TAB>current name
#   bureau-receivers --rename <proto> <name>  # rename a receiver
#   bureau-receivers --rename-all <name>      # rename all receivers at once
#   bureau-receivers --player <proto> <cmd>   # play/pause/stop/next/prev
#   bureau-receivers --player-info <proto>    # TSV: status<TAB>title<TAB>artist<TAB>album<TAB>position<TAB>duration
#   bureau-receivers --volume <proto> <val>   # set volume 0-100
#   bureau-receivers --volume-info <proto>    # print current volume 0-100
#
set -euo pipefail

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/gmediarender.conf"

# Services: friendly_name <TAB> systemd_unit
SERVICES=(
    "DLNA	gmediarender.service"
    "AirPlay	shairport-sync.service"
    "Spotify	librespot.service"
)

# --- Sink helpers (same logic as before, for gmediarender) ---

active_sink() {
    local gmr_id sink_id sink_name
    gmr_id="$(pactl list sink-inputs 2>/dev/null | awk '
        /^Sink Input #/ { id=$3 }
        /application.name.*=.*gmediarender/ { print id; exit }
    ')"
    if [[ -n "$gmr_id" ]]; then
        sink_id="$(pactl list sink-inputs 2>/dev/null | awk -v target="$gmr_id" '
            /^Sink Input #/ { id=$3 }
            id==target && /^[\t ]*Sink:/ { print $2; exit }
        ')"
        if [[ -n "$sink_id" ]]; then
            sink_name="$(pactl list sinks 2>/dev/null | awk -v s="$sink_id" '
                /^Sink #/ { cur=substr($2, 2) }
                /^[\t ]*Name:/ && cur==s { print $2 }
            ')"
            [[ -n "$sink_name" ]] && { echo "$sink_name"; return 0; }
        fi
    fi
    awk -F'"' '/^GMRENDER_AUDIO_DEVICE=/{print $2}' "$CONF"
}

sync_config() {
    local live conf_val
    live="$(active_sink)"
    [[ -z "$live" ]] && return 0
    conf_val="$(awk -F'"' '/^GMRENDER_AUDIO_DEVICE=/{print $2}' "$CONF")"
    [[ "$live" == "$conf_val" ]] && return 0
    sed -i 's/^GMRENDER_AUDIO_DEVICE=/#GMRENDER_AUDIO_DEVICE=/' "$CONF"
    sed -i "s|^#GMRENDER_AUDIO_DEVICE=\"$live\"|GMRENDER_AUDIO_DEVICE=\"$live\"|" "$CONF"
    if ! grep -q "^GMRENDER_AUDIO_DEVICE=\"$live\"" "$CONF"; then
        sed -i "s|^#GMRENDER_AUDIO_DEVICE=.*|GMRENDER_AUDIO_DEVICE=\"$live\"|" "$CONF"
    fi
}

# --- Commands ---

cmd_services() {
    for entry in "${SERVICES[@]}"; do
        local name="${entry%%	*}"
        local svc="${entry##*	}"
        if systemctl --user is-active --quiet "$svc" 2>/dev/null; then
            printf '%s\t%s\t1\n' "$name" "$svc"
        else
            printf '%s\t%s\t0\n' "$name" "$svc"
        fi
    done
}

cmd_sinks() {
    sync_config
    pactl list sinks 2>/dev/null | awk '
        /^[\t ]*Name:/ { name=$2 }
        /^[\t ]*Description:/ {
            sub(/^[\t ]*Description:[\t ]*/,"");
            desc=$0;
            print desc "\t" name "\t" (name == ACTIVE ? 1 : 0);
        }
    ' ACTIVE="$(active_sink)"
}

cmd_current() {
    active_sink
}

cmd_toggle() {
    local svc="$1"
    if systemctl --user is-active --quiet "$svc" 2>/dev/null; then
        systemctl --user stop "$svc"
    else
        systemctl --user start "$svc"
    fi
}

cmd_restart() {
    local svc="$1"
    systemctl --user restart "$svc"
}

cmd_restart_all() {
    for entry in "${SERVICES[@]}"; do
        local svc="${entry##*	}"
        systemctl --user restart "$svc" 2>/dev/null || true
    done
}

cmd_switch() {
    local target="$1"
    if ! pactl list short sinks 2>/dev/null | awk '{print $2}' | grep -qx "$target"; then
        echo "unknown sink: $target" >&2
        exit 1
    fi
    sed -i 's/^GMRENDER_AUDIO_DEVICE=/#GMRENDER_AUDIO_DEVICE=/' "$CONF"
    sed -i "s|^#GMRENDER_AUDIO_DEVICE=\"$target\"|GMRENDER_AUDIO_DEVICE=\"$target\"|" "$CONF"
    if ! grep -q "^GMRENDER_AUDIO_DEVICE=\"$target\"" "$CONF"; then
        sed -i "s|^#GMRENDER_AUDIO_DEVICE=.*|GMRENDER_AUDIO_DEVICE=\"$target\"|" "$CONF"
    fi
    local gmr_id
    gmr_id="$(pactl list sink-inputs 2>/dev/null | awk '
        /^Sink Input #/ { id=$3 }
        /application.name.*=.*gmediarender/ { print id; exit }
    ')"
    gmr_id="${gmr_id#\#}"
    if [[ -n "$gmr_id" ]]; then
        pactl move-sink-input "$gmr_id" "$target" 2>/dev/null || true
    fi
    pactl set-default-sink "$target" 2>/dev/null || true
}

cmd_names() {
    # TSV: protocol <TAB> current name
    local dlna_name airplay_name spotify_name
    dlna_name="$(awk -F'"' '/^GMRENDER_FRIENDLY_NAME=/{print $2}' "$CONF")"
    airplay_name="$(awk -F'"' '/^[[:space:]]*name[[:space:]]*=/{print $2}' "${XDG_CONFIG_HOME:-$HOME/.config}/shairport-sync.conf")"
    spotify_name="$(awk -F'"' '/--name/{print $2}' "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/librespot.service")"
    printf 'DLNA\t%s\n' "${dlna_name:-Bureau (DLNA)}"
    printf 'AirPlay\t%s\n' "${airplay_name:-Bureau (AirPlay)}"
    printf 'Spotify\t%s\n' "${spotify_name:-Bureau (Spotify)}"
}

cmd_rename() {
    local proto="$1" name="$2"
    local shairport_conf="${XDG_CONFIG_HOME:-$HOME/.config}/shairport-sync.conf"
    local librespot_svc="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/librespot.service"
    case "$proto" in
        DLNA)
            sed -i "s|^GMRENDER_FRIENDLY_NAME=.*|GMRENDER_FRIENDLY_NAME=\"$name\"|" "$CONF"
            systemctl --user restart gmediarender.service 2>/dev/null || true
            ;;
        AirPlay)
            sed -i "s|^[[:space:]]*name[[:space:]]*=.*|    name = \"$name\";|" "$shairport_conf"
            systemctl --user restart shairport-sync.service 2>/dev/null || true
            ;;
        Spotify)
            sed -i "s|--name \"[^\"]*\"|--name \"$name\"|" "$librespot_svc"
            systemctl --user daemon-reload 2>/dev/null || true
            systemctl --user restart librespot.service 2>/dev/null || true
            ;;
        *) echo "unknown protocol: $proto" >&2; exit 1 ;;
    esac
}

cmd_rename_all() {
    local base="$1"
    local shairport_conf="${XDG_CONFIG_HOME:-$HOME/.config}/shairport-sync.conf"
    local librespot_svc="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/librespot.service"
    # Each receiver gets a protocol suffix so they're distinguishable.
    local dlna_name="$base (DLNA)"
    local airplay_name="$base (AirPlay)"
    local spotify_name="$base (Spotify)"
    # DLNA
    sed -i "s|^GMRENDER_FRIENDLY_NAME=.*|GMRENDER_FRIENDLY_NAME=\"$dlna_name\"|" "$CONF"
    # AirPlay
    sed -i "s|^[[:space:]]*name[[:space:]]*=.*|    name = \"$airplay_name\";|" "$shairport_conf"
    # Spotify
    sed -i "s|--name \"[^\"]*\"|--name \"$spotify_name\"|" "$librespot_svc"
    systemctl --user daemon-reload 2>/dev/null || true
    systemctl --user restart gmediarender.service shairport-sync.service librespot.service 2>/dev/null || true
}

# --- Player controls ---

# Returns the protocol that has an active (non-corked) PulseAudio stream.
# Prints "AirPlay", "DLNA", "Spotify", or empty.
cmd_active_player() {
    # Check which receiver has an active stream (playing OR paused).
    # "Corked: no" = playing, "Corked: yes" = paused, no stream = inactive.
    # We return any protocol with a stream, even if paused, so the applet
    # can show transport controls to resume playback.
    local out
    out="$(pactl list sink-inputs 2>/dev/null | awk '
        /^Sink Input #/ { id=substr($3, 2); app="" }
        /application.name.*shairport/ { app="AirPlay" }
        /application.name.*gmediarender/ { app="DLNA" }
        /application.name.*librespot/ { app="Spotify" }
        app != "" { print app; app="" }
    ')"
    echo "$out" | head -1
}

# --- Track history ---

HISTORY_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/bureau-receivers/history.tsv"

# Log a track to the history file. Called from --player-info when a new
# track is detected. Format: timestamp<TAB>protocol<TAB>title<TAB>artist<TAB>album
cmd_history_log() {
    local proto="$1" title="$2" artist="$3" album="$4"
    [[ -z "$title" ]] && return 0
    mkdir -p "$(dirname "$HISTORY_FILE")"
    # Avoid duplicate consecutive entries.
    local last
    last="$(tail -1 "$HISTORY_FILE" 2>/dev/null || echo '')"
    local last_title="${last#*	}"
    last_title="${last_title#*	}"  # skip protocol
    last_title="${last_title%%	*}"  # keep only title
    [[ "$last_title" == "$title" ]] && return 0
    local ts
    ts="$(date '+%Y-%m-%d %H:%M:%S')"
    printf '%s\t%s\t%s\t%s\t%s\n' "$ts" "$proto" "$title" "${artist:-}" "${album:-}" >> "$HISTORY_FILE"
}

# Print recent history. Default 20 entries.
cmd_history() {
    local n="${1:-20}"
    [[ -f "$HISTORY_FILE" ]] && tail -"$n" "$HISTORY_FILE" || true
}

# Find the PulseAudio sink-input ID for a given application name.
pa_sink_input_id() {
    local app="$1"
    pactl list sink-inputs 2>/dev/null | awk -v app="$app" '
        /^Sink Input #/ { id=substr($3, 2) }
        tolower($0) ~ tolower(app) { print id; exit }
    '
}

cmd_player() {
    local proto="$1" cmd="$2"
    case "$proto" in
        AirPlay)
            local bus="org.gnome.ShairportSync"
            local rc="$bus.RemoteControl"
            local path="/org/gnome/ShairportSync"
            case "$cmd" in
                play)     busctl --user call "$bus" "$path" "$rc" Play ;;
                pause)    busctl --user call "$bus" "$path" "$rc" Pause ;;
                stop)     busctl --user call "$bus" "$path" "$rc" Stop ;;
                playpause) busctl --user call "$bus" "$path" "$rc" PlayPause ;;
                next)     busctl --user call "$bus" "$path" "$rc" Next ;;
                prev)     busctl --user call "$bus" "$path" "$rc" Previous ;;
            esac
            ;;
        Spotify)
            # librespot doesn't expose MPRIS — transport is controlled
            # from the Spotify app on the source device.
            echo "Spotify transport is controlled from the Spotify app" >&2
            ;;
        DLNA)
            # DLNA transport via UPnP SOAP AVTransport.
            local port ip url
            ip="$(ip -4 addr show 2>/dev/null | grep -oP 'inet \K[0-9.]+' | grep -v '^127\.' | head -1)"
            [[ -z "$ip" ]] && ip="127.0.0.1"
            port="$(ss -tlnp 2>/dev/null | grep gmediarender | head -1 | grep -oP ':\K[0-9]+' || echo '49494')"
            url="http://$ip:$port/upnp/control/rendertransport1"
            local soap_action
            case "$cmd" in
                play)     soap_action="Play";;
                pause)    soap_action="Pause";;
                stop)     soap_action="Stop";;
                playpause)
                    local state
                    state="$(curl -s -X POST "$url" \
                        -H 'Content-Type: text/xml; charset="utf-8"' \
                        -H 'SOAPAction: "urn:schemas-upnp-org:service:AVTransport:1#GetTransportInfo"' \
                        -d '<?xml version="1.0"?><s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/"><s:Body><u:GetTransportInfo xmlns:u="urn:schemas-upnp-org:service:AVTransport:1"><InstanceID>0</InstanceID></u:GetTransportInfo></s:Body></s:Envelope>' \
                        2>/dev/null | grep -oP 'CurrentTransportState>\K[^<]+')"
                    if [[ "$state" == "PLAYING" ]]; then
                        soap_action="Pause"
                    else
                        soap_action="Play"
                    fi
                    ;;
                next)     soap_action="Next";;
                prev)     soap_action="Previous";;
                seek)
                    # Seek to a position in seconds (cmd arg 3).
                    local target="${3:-0}"
                    # Convert seconds to H:MM:SS.
                    local h m s timestr
                    h=$((target / 3600))
                    m=$(((target % 3600) / 60))
                    s=$((target % 60))
                    timestr=$(printf '%d:%02d:%02d' "$h" "$m" "$s")
                    curl -s -X POST "$url" \
                        -H 'Content-Type: text/xml; charset="utf-8"' \
                        -H 'SOAPAction: "urn:schemas-upnp-org:service:AVTransport:1#Seek"' \
                        -d "<?xml version=\"1.0\"?><s:Envelope xmlns:s=\"http://schemas.xmlsoap.org/soap/envelope/\"><s:Body><u:Seek xmlns:u=\"urn:schemas-upnp-org:service:AVTransport:1\"><InstanceID>0</InstanceID><Unit>REL_TIME</Unit><Target>$timestr</Target></u:Seek></s:Body></s:Envelope>" \
                        >/dev/null 2>&1
                    return
                    ;;
            esac
            local body
            if [[ "$soap_action" == "Play" ]]; then
                body="<u:Play xmlns:u=\"urn:schemas-upnp-org:service:AVTransport:1\"><InstanceID>0</InstanceID><Speed>1</Speed></u:Play>"
            else
                body="<u:$soap_action xmlns:u=\"urn:schemas-upnp-org:service:AVTransport:1\"><InstanceID>0</InstanceID></u:$soap_action>"
            fi
            curl -s -X POST "$url" \
                -H 'Content-Type: text/xml; charset="utf-8"' \
                -H "SOAPAction: \"urn:schemas-upnp-org:service:AVTransport:1#$soap_action\"" \
                -d "<?xml version=\"1.0\"?><s:Envelope xmlns:s=\"http://schemas.xmlsoap.org/soap/envelope/\"><s:Body>$body</s:Body></s:Envelope>" \
                >/dev/null 2>&1
            ;;
    esac
}

cmd_player_info() {
    local proto="$1"
    case "$proto" in
        AirPlay)
            local bus="org.gnome.ShairportSync"
            local rc="$bus.RemoteControl"
            local path="/org/gnome/ShairportSync"
            local status title artist album pos dur available
            status="$(busctl --user get-property "$bus" "$path" "$rc" PlayerState 2>/dev/null | sed 's/^s //' | tr -d '"')"
            # Metadata is a{sv} — extract xesam:title, xesam:artist, xesam:album.
            local meta
            meta="$(busctl --user get-property "$bus" "$path" "$rc" Metadata 2>/dev/null)"
            title="$(echo "$meta" | grep -oP '"xesam:title" s "\K[^"]*' || echo '')"
            artist="$(echo "$meta" | grep -oP '"xesam:artist" as \d+ "\K[^"]*' || echo '')"
            album="$(echo "$meta" | grep -oP '"xesam:album" s "\K[^"]*' || echo '')"
            # ProgressString: "start/current/end" in samples (44100 Hz).
            # In classic AirPlay, ProgressString doesn't update in real time —
            # it only changes when a new track starts. So we compute position
            # from wall-clock elapsed time since the track started.
            local prog
            prog="$(busctl --user get-property "$bus" "$path" "$rc" ProgressString 2>/dev/null | sed 's/^s //' | tr -d '"')"
            if [[ "$prog" =~ ^([0-9]+)/([0-9]+)/([0-9]+)$ ]]; then
                dur=$(awk -v s="${BASH_REMATCH[1]}" -v e="${BASH_REMATCH[3]}" 'BEGIN{printf "%d", (e-s)/44100}')
            else
                dur="0"
            fi
            # Compute position from wall-clock time.
            # State file format: line 1 = title, line 2 = "playing:<epoch>" or "paused:<pos>"
            local state_file="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/airplay-position"
            local prev_title="" prev_state="" prev_mode="" prev_val=""
            if [[ -f "$state_file" ]]; then
                prev_title="$(head -1 "$state_file" 2>/dev/null || echo '')"
                prev_state="$(tail -1 "$state_file" 2>/dev/null || echo '')"
                prev_mode="${prev_state%%:*}"
                prev_val="${prev_state#*:}"
            fi
            local now
            now="$(date +%s)"
            if [[ "$title" != "$prev_title" ]]; then
                # New track — start counting from zero.
                echo "$title" > "$state_file"
                echo "playing:$now" >> "$state_file"
                pos="0"
            elif [[ "$status" == "Playing" ]]; then
                if [[ "$prev_mode" == "playing" ]]; then
                    # Still playing — elapsed since start.
                    pos=$((now - prev_val))
                elif [[ "$prev_mode" == "paused" ]]; then
                    # Resumed from pause — adjust start time.
                    local start_adj=$((now - prev_val))
                    echo "$title" > "$state_file"
                    echo "playing:$start_adj" >> "$state_file"
                    pos="$prev_val"
                fi
                # Clamp to duration.
                if (( dur > 0 && pos > dur )); then
                    pos="$dur"
                fi
            else
                # Paused — store current position.
                pos="${prev_val:-0}"
                if [[ "$prev_mode" == "playing" ]]; then
                    pos=$((now - prev_val))
                    if (( dur > 0 && pos > dur )); then
                        pos="$dur"
                    fi
                fi
                echo "$title" > "$state_file"
                echo "paused:$pos" >> "$state_file"
            fi
            # If stopped, show as Inactive so the applet skips it.
            [[ "$status" == "Stopped" || "$status" == "N/A" ]] && status="Inactive"
            printf '%s\t%s\t%s\t%s\t%s\t%s\n' "${status:-}" "${title:-}" "${artist:-}" "${album:-}" "${pos:-0}" "${dur:-0}"
            ;;
        Spotify)
            # librespot doesn't expose MPRIS. Read from the event file if present.
            local state_file="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/librespot-state"
            local status title artist album pos dur
            if [[ -f "$state_file" ]]; then
                source "$state_file" 2>/dev/null
                printf '%s\t%s\t%s\t%s\t%s\t%s\n' "${status:-}" "${title:-}" "${artist:-}" "${album:-}" "${pos:-0}" "${dur:-0}"
            else
                printf 'Stopped\t\t\t\t0\t0\n'
            fi
            ;;
        DLNA)
            # Query gmediarender via UPnP SOAP AVTransport.
            local port ip
            ip="$(ip -4 addr show 2>/dev/null | grep -oP 'inet \K[0-9.]+' | grep -v '^127\.' | head -1)"
            [[ -z "$ip" ]] && ip="127.0.0.1"
            port="$(ss -tlnp 2>/dev/null | grep gmediarender | head -1 | grep -oP ':\K[0-9]+' || echo '49494')"
            local url="http://$ip:$port/upnp/control/rendertransport1"

            # GetTransportInfo for status.
            local status
            status="$(curl -s -X POST "$url" \
                -H 'Content-Type: text/xml; charset="utf-8"' \
                -H 'SOAPAction: "urn:schemas-upnp-org:service:AVTransport:1#GetTransportInfo"' \
                -d '<?xml version="1.0"?><s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/"><s:Body><u:GetTransportInfo xmlns:u="urn:schemas-upnp-org:service:AVTransport:1"><InstanceID>0</InstanceID></u:GetTransportInfo></s:Body></s:Envelope>' \
                2>/dev/null | tr -d '\r' | grep -oP 'CurrentTransportState>\K[^<]+' | head -1 || echo '')"

            # GetPositionInfo for track metadata and position.
            local posinfo title artist album pos dur
            posinfo="$(curl -s -X POST "$url" \
                -H 'Content-Type: text/xml; charset="utf-8"' \
                -H 'SOAPAction: "urn:schemas-upnp-org:service:AVTransport:1#GetPositionInfo"' \
                -d '<?xml version="1.0"?><s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/"><s:Body><u:GetPositionInfo xmlns:u="urn:schemas-upnp-org:service:AVTransport:1"><InstanceID>0</InstanceID></u:GetPositionInfo></s:Body></s:Envelope>' \
                2>/dev/null | tr -d '\r' || echo '')"

            # Decode HTML entities in the metadata (DIDL-Lite is XML-encoded).
            local decoded
            decoded="$(echo "$posinfo" | python3 -c 'import sys,html; print(html.unescape(sys.stdin.read()))' 2>/dev/null || echo "$posinfo")"
            # Parse DIDL-Lite metadata for title, artist, album.
            title="$(echo "$decoded" | grep -oP 'dc:title>\K[^<]+' || echo '')"
            artist="$(echo "$decoded" | grep -oP 'upnp:artist>\K[^<]+' || echo '')"
            album="$(echo "$decoded" | grep -oP 'upnp:album>\K[^<]+' || echo '')"
            dur="$(echo "$posinfo" | grep -oP 'TrackDuration>\K[^<]+' | head -1 || echo '0:00:00')"
            pos="$(echo "$posinfo" | grep -oP 'RelTime>\K[^<]+' | head -1 || echo '0:00:00')"

            # Convert H:MM:SS to seconds.
            pos="$(echo "$pos" | awk -F: '{print ($1*60+$2)*60+$3}')"
            dur="$(echo "$dur" | awk -F: '{print ($1*60+$2)*60+$3}')"

            # Map UPnP states to our format.
            case "$status" in
                PLAYING) status="Playing" ;;
                PAUSED_PLAYBACK) status="Paused" ;;
                STOPPED|*) status="${status:-Inactive}" ;;
            esac

            printf '%s\t%s\t%s\t%s\t%s\t%s\n' "${status:-}" "${title:-}" "${artist:-}" "${album:-}" "${pos:-0}" "${dur:-0}"
            ;;
    esac

    # Log track to history (deduplicated).
    [[ -n "${title:-}" ]] && cmd_history_log "$proto" "${title:-}" "${artist:-}" "${album:-}"
}

cmd_volume() {
    local proto="$1" val="$2"
    local id
    case "$proto" in
        DLNA)   id="$(pa_sink_input_id gmediarender)" ;;
        AirPlay) id="$(pa_sink_input_id shairport)" ;;
        Spotify) id="$(pa_sink_input_id librespot)" ;;
    esac
    if [[ -n "$id" ]]; then
        local pct=$((val))
        pactl set-sink-input-volume "$id" "${pct}%" 2>/dev/null
    fi
}

cmd_volume_info() {
    local proto="$1"
    local id
    case "$proto" in
        DLNA)   id="$(pa_sink_input_id gmediarender)" ;;
        AirPlay) id="$(pa_sink_input_id shairport)" ;;
        Spotify) id="$(pa_sink_input_id librespot)" ;;
    esac
    if [[ -n "$id" ]]; then
        pactl list sink-inputs 2>/dev/null | awk -v target="$id" '
            /^Sink Input #/ { id=substr($3, 2) }
            id==target && /Volume/ {
                for (i=1; i<=NF; i++) {
                    if ($i ~ /%/) { gsub(/%/,"",$i); print $i; exit }
                }
            }
        '
    else
        echo "0"
    fi
}

case "${1:-}" in
    --services)    cmd_services ;;
    --sinks)        cmd_sinks ;;
    --status)       systemctl --user is-active --quiet gmediarender.service ;;
    --current)      cmd_current ;;
    --toggle)       cmd_toggle "${2:-}" ;;
    --restart)      cmd_restart "${2:-}" ;;
    --restart-all)  cmd_restart_all ;;
    --names)         cmd_names ;;
    --rename)        cmd_rename "${2:-}" "${3:-}" ;;
    --rename-all)    cmd_rename_all "${2:-}" ;;
    --player)        cmd_player "${2:-}" "${3:-}" ;;
    --player-info)   cmd_player_info "${2:-}" ;;
    --volume)        cmd_volume "${2:-}" "${3:-}" ;;
    --volume-info)   cmd_volume_info "${2:-}" ;;
    --active-player) cmd_active_player ;;
    --history)       cmd_history "${2:-20}" ;;
    "")             cmd_sinks ;;
    -h|--help)
        sed -n '2,/^$/p' "$0" | sed 's/^# \?//'
        ;;
    *)              cmd_switch "$1" ;;
esac