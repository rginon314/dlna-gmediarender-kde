#!/usr/bin/env bash
# gmediarender-output — query/switch the DLNA renderer output sink.
#
#   gmediarender-output              # list sinks (TSV: desc<TAB>name<TAB>active)
#   gmediarender-output --status     # exit 0 if renderer running, 1 otherwise
#   gmediarender-output --current    # print active sink name
#   gmediarender-output <sink-name>  # switch to sink WITHOUT restarting
#
set -euo pipefail

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/gmediarender.conf"

active_sink() {
    awk -F'"' '/^GMRENDER_AUDIO_DEVICE=/{print $2}' "$CONF"
}

cmd_data() {
    # TSV: description <TAB> sink-name <TAB> active(0/1)
    pactl list sinks 2>/dev/null | awk '
        /^[\t ]*Name:/ { name=$2 }
        /^[\t ]*Description:/ {
            sub(/^[\t ]*Description:[\t ]*/,"");
            desc=$0;
            print desc "\t" name "\t" (name == ACTIVE ? 1 : 0);
        }
    ' ACTIVE="$(active_sink)"
}

cmd_status() {
    systemctl --user is-active --quiet gmediarender.service
}

cmd_current() {
    active_sink
}

cmd_switch() {
    local target="$1"
    # Validate the sink exists
    if ! pactl list short sinks 2>/dev/null | awk '{print $2}' | grep -qx "$target"; then
        echo "unknown sink: $target" >&2
        exit 1
    fi

    # Update the config file (for next service restart).
    sed -i 's/^GMRENDER_AUDIO_DEVICE=/#GMRENDER_AUDIO_DEVICE=/' "$CONF"
    sed -i "s|^#GMRENDER_AUDIO_DEVICE=\"$target\"|GMRENDER_AUDIO_DEVICE=\"$target\"|" "$CONF"
    if ! grep -q "^GMRENDER_AUDIO_DEVICE=\"$target\"" "$CONF"; then
        sed -i "s|^#GMRENDER_AUDIO_DEVICE=.*|GMRENDER_AUDIO_DEVICE=\"$target\"|" "$CONF"
    fi

    # Move the live gmediarender stream to the new sink, without restarting.
    # This keeps the current DLNA session alive — audio continues transparently.
    local moved=0
    while read -r id _ sink _; do
        [[ "$id" =~ ^[0-9]+$ ]] || continue
        if pactl move-sink-input "$id" "$target" 2>/dev/null; then
            moved=1
        fi
    done < <(pactl list short sink-inputs 2>/dev/null | grep -i 'gmediarender')

    # If no live stream was found (nothing playing), also set the default sink
    # so the next track goes to the right place.
    pactl set-default-sink "$target" 2>/dev/null || true

    if (( moved == 0 )); then
        # No active stream to move — nothing breaks, the config is already
        # updated for the next track.
        :
    fi
}

case "${1:-}" in
    --data)   cmd_data ;;
    --status) cmd_status ;;
    --current) cmd_current ;;
    "")       cmd_data ;;
    -h|--help)
        sed -n '2,/^$/p' "$0" | sed 's/^# \?//'
        ;;
    *)        cmd_switch "$1" ;;
esac